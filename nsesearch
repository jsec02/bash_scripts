#!/usr/bin/env bash

# ================================================================================
# =                                  NSESEARCH                                   =
# ================================================================================

set -eou pipefail

NAME=${0##*/}

WORDS=()

usage() {
    echo "Usage: $NAME [words...]"
}

parse_args() {
    if (($# == 0)); then
        usage >&2
        exit 1
    fi

    while (($# > 0)); do
        WORDS+=("$1")
        shift
    done

}

build_pattern() {
    PATTERN=$(
        IFS="|"
        echo "${WORDS[*]}"
    )
}

grep_scripts() {
    local scriptdb result word

    if [[ -e "/usr/share/nmap/scripts/script.db" ]]; then
        scriptdb="/usr/share/nmap/scripts/script.db"
    else
        echo "script.db file not found" >&2
        exit 1
    fi

    result=$(cat "$scriptdb")
    for word in "${WORDS[@]}"; do
        result=$(grep --color=never -- "$word" <<<"$result") || {
            echo "No scripts found" >&2
            exit 1
        }
    done

    # re-grep once more at the end just for color highlighting
    grep --color=auto --extended-regexp -- "$PATTERN" <<<"$result"
}

main() {
    parse_args "$@"
    build_pattern
    grep_scripts
}

main "$@"
